      "feedback"
    ],
    "useCases": [
      "Always-available chat or messaging entry",
      "Support link on long marketing pages"
    ],
    "avoidWhen": [
      "Pages where a fixed corner element covers content or other floating controls",
      "Apps that already have a chat widget"
