{
  "id": "CTA-002",
  "slug": "sliding-arrow",
  "name": "Sliding Arrow CTA",
  "category": "CTA",
  "version": "1.0.0",
  "lifecycle": "alpha",
  "description": "Solid call-to-action whose trailing arrow slides out and a second arrow slides in on hover.",
  "inspiration": [],
  "interaction": {
    "class": "C",
    "modules": [
      "arrow-swap"
    ],
    "params": {
      "duration": 300
    }
  },
  "slots": {
    "label": {
      "required": true
    },
    "icon": {
      "required": false
    }
  },
  "props": {
    "size": [
      "sm",
      "md",
      "lg"
    ]
  },
  "skins": [
    {
      "id": "solid-accent",
      "bind": {
        "--ds-cta-bg": "color.accent",
        "--ds-cta-bg-hover": "color.accent.hover",
        "--ds-cta-fg": "color.on-accent",
        "--ds-cta-fg-hover": "color.on-accent",
        "--ds-cta-border": "transparent"
      }
    }
  ],
  "tokens": [
    "--ds-cta-bg",
    "--ds-cta-bg-hover",
    "--ds-cta-fg",
    "--ds-cta-fg-hover",
    "--ds-cta-border",
    "--ds-cta-border-width",
    "--ds-cta-radius",
    "--ds-cta-height",
    "--ds-cta-padding-x",
    "--ds-cta-font",
    "--ds-cta-focus",
    "--ds-cta-fade-duration",
    "--ds-cta-fade-ease",
    "--ds-cta-spin-duration",
    "--ds-cta-slide-duration",
    "--ds-cta-ease"
  ],
  "constraints": {
    "radiusSupport": "any",
    "radiusNote": "The clip lives on the small inner icon box, not on the button edge, so the outer radius never affects it.",
    "requiresHost": [
      "position:relative"
    ],
    "minContrast": "AA",
    "insetLayers": []
  },
  "states": [
    "default",
    "hover",
    "focus-visible",
    "active",
    "loading",
    "disabled"
  ],
  "responsive": {
    "touchTarget": "44px",
    "hoverFallback": "arrow swap is decorative; hover colour change is the only hover-only cue"
  },
  "a11y": {
    "role": "button",
    "keyboard": [
      "Enter",
      "Space"
    ],
    "reducedMotion": "static-end-state"
  },
  "figma": null,
  "code": {
    "path": "packages/components/src/cta/002-sliding-arrow",
    "hash": null
  },
  "testing": {
    "conformance": "none",
    "a11y": "pending",
    "visual": null
  },
  "discovery": {
    "tags": [
      "button",
      "arrow",
      "link-like",
      "editorial"
    ],
    "interaction": [
      "hover-press"
    ],
    "useCases": [
      "Read more or continue actions",
      "Moving forward in a flow"
    ],
    "avoidWhen": [
      "Destructive actions"
    ],
    "pairsWith": [
      "CRD-004",
      "CRD-002"
    ],
    "effects": "full"
  }
}
