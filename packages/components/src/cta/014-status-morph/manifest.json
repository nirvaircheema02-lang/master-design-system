{
  "id": "CTA-014",
  "slug": "status-morph",
  "name": "Status Morph CTA",
  "category": "CTA",
  "version": "1.0.0",
  "lifecycle": "alpha",
  "description": "A controlled CTA that morphs from its label to a spinner, then a check (success) or cross (error) inside a fixed-size button. Result is announced; error allows a retry.",
  "inspiration": [],
  "interaction": {
    "class": "C",
    "modules": [
      "status-morph"
    ],
    "params": {
      "duration": 300
    },
    "js": false,
    "pointerVars": []
  },
  "slots": {
    "label": {
      "required": true
    }
  },
  "props": {
    "size": [
      "sm",
      "md",
      "lg"
    ],
    "status": [
      "idle",
      "loading",
      "success",
      "error"
    ]
  },
  "skins": [
    {
      "id": "solid-accent",
      "bind": {
        "--ds-cta-bg": "color.accent",
        "--ds-cta-bg-hover": "color.accent.hover",
        "--ds-cta-fg": "color.on-accent",
        "--ds-cta-fg-hover": "color.on-accent",
        "--ds-cta-border": "transparent"
      }
    },
    {
      "id": "outline-invert",
      "bind": {
        "--ds-cta-bg": "transparent",
        "--ds-cta-bg-hover": "color.accent",
        "--ds-cta-fg": "color.accent.ink",
        "--ds-cta-fg-hover": "color.on-accent",
        "--ds-cta-border": "color.accent.ink"
      }
    }
  ],
  "tokens": [
    "--ds-cta-bg",
    "--ds-cta-bg-hover",
    "--ds-cta-fg",
    "--ds-cta-fg-hover",
    "--ds-cta-border",
    "--ds-cta-border-width",
    "--ds-cta-radius",
    "--ds-cta-height",
    "--ds-cta-padding-x",
    "--ds-cta-font",
    "--ds-cta-focus",
    "--ds-cta-fade-duration",
    "--ds-cta-fade-ease",
    "--ds-cta-spin-duration",
    "--ds-cta-ok-bg",
    "--ds-cta-ok-fg",
    "--ds-cta-err-bg",
    "--ds-cta-err-fg",
    "--ds-cta-wipe-duration",
    "--ds-cta-ease"
  ],
  "constraints": {
    "radiusSupport": "any",
    "requiresHost": [],
    "minContrast": "AA",
    "insetLayers": [],
    "radiusNote": "The host clips the status marks (overflow: hidden) and the fill is the host background, so any radius works."
  },
  "states": [
    "default",
    "hover",
    "focus-visible",
    "active",
    "loading",
    "disabled",
    "success",
    "error"
  ],
  "responsive": {
    "touchTarget": "44px",
    "hoverFallback": "status marks are decorative; the result is spoken through a live region"
  },
  "a11y": {
    "role": "button",
    "keyboard": [
      "Enter",
      "Space"
    ],
    "reducedMotion": "static-end-state",
    "elements": [
      "button"
    ],
    "inertStates": [
      "success"
    ]
  },
  "figma": null,
  "code": {
    "path": "packages/components/src/cta/014-status-morph",
    "hash": null
  },
  "testing": {
    "conformance": "none",
    "a11y": "pending",
    "visual": null
  },
  "discovery": {
    "tags": [
      "button",
      "status",
      "loading",
      "submit"
    ],
    "interaction": [
      "feedback",
      "hover-press"
    ],
    "useCases": [
      "Submit and save with visible progress",
      "Anything that takes time"
    ],
    "avoidWhen": [
      "Instant actions"
    ],
    "pairsWith": [
      "INP-001",
      "FRM-001",
      "TST-001"
    ],
    "effects": "subtle"
  }
}
