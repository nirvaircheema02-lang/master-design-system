{
  "id": "CTA-006",
  "slug": "glow",
  "name": "Glow CTA",
  "category": "CTA",
  "version": "1.0.0",
  "lifecycle": "alpha",
  "description": "A soft halo around the button fades in on hover and focus. The shadow is pre-drawn on a layer; only its opacity animates.",
  "inspiration": [],
  "interaction": {
    "class": "B",
    "modules": [
      "glow-halo"
    ],
    "params": {
      "duration": 150
    }
  },
  "slots": {
    "label": {
      "required": true
    }
  },
  "props": {
    "size": [
      "sm",
      "md",
      "lg"
    ]
  },
  "skins": [
    {
      "id": "solid-accent",
      "bind": {
        "--ds-cta-bg": "color.accent",
        "--ds-cta-bg-hover": "color.accent.hover",
        "--ds-cta-fg": "color.on-accent",
        "--ds-cta-fg-hover": "color.on-accent",
        "--ds-cta-border": "transparent",
        "--ds-cta-glow": "color.accent"
      }
    },
    {
      "id": "surface-glow",
      "bind": {
        "--ds-cta-bg": "color.surface.raised",
        "--ds-cta-bg-hover": "color.surface.sunken",
        "--ds-cta-fg": "color.text.primary",
        "--ds-cta-fg-hover": "color.text.primary",
        "--ds-cta-border": "color.text.secondary",
        "--ds-cta-glow": "color.accent"
      }
    }
  ],
  "tokens": [
    "--ds-cta-bg",
    "--ds-cta-bg-hover",
    "--ds-cta-fg",
    "--ds-cta-fg-hover",
    "--ds-cta-border",
    "--ds-cta-border-width",
    "--ds-cta-radius",
    "--ds-cta-height",
    "--ds-cta-padding-x",
    "--ds-cta-font",
    "--ds-cta-focus",
    "--ds-cta-fade-duration",
    "--ds-cta-fade-ease",
    "--ds-cta-spin-duration",
    "--ds-cta-glow"
  ],
  "constraints": {
    "radiusSupport": "any",
    "requiresHost": [
      "position:relative"
    ],
    "minContrast": "AA",
    "insetLayers": []
  },
  "states": [
    "default",
    "hover",
    "focus-visible",
    "active",
    "loading",
    "disabled"
  ],
  "responsive": {
    "touchTarget": "44px",
    "hoverFallback": "glow is decorative; the hover fill change is the only hover-only cue"
  },
  "a11y": {
    "role": "button",
    "keyboard": [
      "Enter",
      "Space"
    ],
    "reducedMotion": "static-end-state"
  },
  "figma": null,
  "code": {
    "path": "packages/components/src/cta/006-glow",
    "hash": null
  },
  "testing": {
    "conformance": "none",
    "a11y": "pending",
    "visual": null
  },
  "discovery": {
    "tags": [
      "button",
      "glow",
      "halo",
      "dark-ui"
    ],
    "interaction": [
      "hover-press"
    ],
    "useCases": [
      "Dark or cinematic pages",
      "Spotlighting a key action"
    ],
    "avoidWhen": [
      "Light, quiet pages"
    ],
    "pairsWith": [
      "NAV-006"
    ],
    "effects": "subtle"
  }
}
